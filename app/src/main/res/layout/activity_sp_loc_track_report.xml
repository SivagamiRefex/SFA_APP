<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">
    <include layout="@layout/layout_toolbar"
        android:id="@+id/layoutToolbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layoutToolbar"
        android:layout_margin="10dp">

        <LinearLayout

            android:id="@+id/ll_sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">
            <TextView
                android:id="@+id/tv_current_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:paddingHorizontal="10dp"
                android:text="27/1/2025"
                android:textColor="@color/green"
                android:textSize="13sp"
                android:layout_gravity="end"
                android:layout_marginStart="10dp"/>
            <TextView
                android:id="@+id/tv_sp_label_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sales Person Name"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"

                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_salesperson"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="10dp"
                    android:layout_marginVertical="10dp"
                    android:layout_weight="0.9">


                    <TextView
                        android:id="@+id/tv_select_sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select the Sales Person"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingVertical="15dp"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:importantForAutofill="no"
                        android:maxLength="70"
                        android:background="@android:color/transparent"/>

                </androidx.cardview.widget.CardView>
                <ImageView
                    android:id="@+id/iv_locrefresh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:src="@drawable/ic_refresh"
                    android:layout_gravity="center"
                    android:visibility="gone"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last tracked Time :"
                    android:textColor="@color/black"
                    android:textStyle="normal"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_track_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:paddingVertical="@dimen/C10dp"
                    android:textSize="15sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last tracked Location :"
                android:textColor="@color/black"
                android:textStyle="normal"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tv_track_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/green"
                android:textStyle="bold"
                android:paddingVertical="@dimen/C10dp"
                android:textSize="15sp"/>

        </LinearLayout>

        <fragment
            android:id="@+id/map"
            android:layout_below="@+id/ll_sp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:name="com.google.android.gms.maps.SupportMapFragment" />
    </RelativeLayout>

</RelativeLayout>