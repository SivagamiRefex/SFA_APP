<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="5dp"
        android:background="@drawable/search_backround"
        android:layout_marginBottom="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:padding="5dp">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Name"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:textSize="22sp"
            android:textColor="@color/pink_color"/>
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="2025/01/10"
                android:layout_marginTop="5dp"
                android:textSize="20sp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/purple_700"/>
        </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:padding="5dp">
        <TextView
            android:id="@+id/tv_intime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_weight="1"
            />
                <TextView
                    android:id="@+id/tv_outtime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textSize="18sp"
                    android:textColor="@color/ref_green"
                    android:layout_weight="1"
                    android:gravity="center"/>


                <TextView
                    android:id="@+id/tv_tottime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textSize="18sp"
                    android:textColor="@color/ref_orange"
                    android:layout_weight="1"
                    android:gravity="end"/>

            </LinearLayout>
            <TextView
                android:id="@+id/tv_activity_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activity Status"
                android:textSize="17sp"
                android:layout_weight="1"
                android:gravity="start"
                android:textStyle="bold"
                android:padding="5dp"
                android:textColor="@color/green" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>