<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="5dp"
    app:cardCornerRadius="5dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/filetypeimage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginVertical="10dp"
            android:layout_gravity="center"
            />

        <TextView
            android:id="@+id/filename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="Tittle of the given file name.pdf"
           android:layout_gravity="center_horizontal"
            android:textStyle="bold"/>
        <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
        android:background="@color/quantum_black_divider"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:layout_marginVertical="10dp"
            android:layout_marginHorizontal="10dp"
            android:orientation="horizontal"
            android:padding="@dimen/C5dp">
            <TextView
                android:id="@+id/filesize"
                android:layout_width="0dp"
                android:layout_marginStart="10dp"
                android:layout_weight="2.5"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="File Size : 350KB"
                android:textColor="@android:color/black"
                android:textSize="12sp"
                android:padding="@dimen/C10dp"/>

            <ImageView
                android:id="@+id/download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_download"
                android:padding="@dimen/C10dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:id="@+id/share"
                android:visibility="gone"
                android:layout_gravity="center"
                android:src="@drawable/ic_share"
                android:padding="@dimen/C10dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:id="@+id/view"
                android:visibility="gone"
                android:layout_gravity="center"
                android:src="@drawable/ic_view"
                android:padding="@dimen/C10dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
