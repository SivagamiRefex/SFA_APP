<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/layout_toolbar"
        android:id="@+id/layoutToolbar"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/C5dp"
        android:layout_marginTop="@dimen/C10dp"
        android:layout_above="@+id/btn_save"
        android:layout_below="@+id/layoutToolbar">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select The Form"
            android:textSize="20sp"
            android:textStyle="normal"
            android:layout_marginHorizontal="5dp"
            android:textColor="@color/dark_blue"/>


        <androidx.cardview.widget.CardView
            android:id="@+id/cv_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            app:cardCornerRadius="5dp"
            app:cardElevation="10dp"
            android:layout_marginHorizontal="@dimen/C5dp">

            <TextView
                android:id="@+id/tv_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select the Form"
                android:paddingVertical="15dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                />

        </androidx.cardview.widget.CardView>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="5dp"
            app:cardElevation="5dp"
            android:layout_marginVertical="5dp"
            android:layout_marginHorizontal="@dimen/C5dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/C10dp">
                <TextView
                    android:id="@+id/tv_assign_person"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assign To  Salesperson  "
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:layout_marginHorizontal="5dp"
                    android:drawableRight="@drawable/ic_person_add_alt"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_list_salesperson"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginVertical="@dimen/C10dp"
                    tools:listitem="@layout/item_assign_data_list"
                    tools:itemCount="4"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="5dp"
            app:cardElevation="5dp"
            android:layout_marginVertical="5dp"
            android:layout_marginHorizontal="@dimen/C5dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/C10dp">
                <TextView
                    android:id="@+id/tv_assign_site"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assign To Site  "
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:layout_marginHorizontal="5dp"
                    android:drawableRight="@drawable/ic_domain_add"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_list_site"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_marginVertical="@dimen/C10dp"
                    tools:listitem="@layout/item_assign_data_list"
                    tools:itemCount="5"/>
            </LinearLayout>
          </androidx.cardview.widget.CardView>
    </LinearLayout>
    </ScrollView>
    </LinearLayout>


    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Save"
        android:textSize="20sp"
        android:textAllCaps="false"

       />

</RelativeLayout>