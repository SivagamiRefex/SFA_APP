<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/layout_toolbar"
        android:id="@+id/layoutToolbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layoutToolbar"
        android:layout_margin="10dp">

        <LinearLayout
            android:id="@+id/ll_sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_sp_label_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sales Person Name"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"

                />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_salesperson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginVertical="10dp">

                <TextView
                    android:id="@+id/tv_select_sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select the Sales Person"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingVertical="15dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:maxLength="70"
                    android:background="@android:color/transparent"/>


            </androidx.cardview.widget.CardView>
        </LinearLayout>
        
        
        <LinearLayout
            android:id="@+id/date_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@+id/ll_sp">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Select Date"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="20sp"
                android:paddingVertical="5dp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="To"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:textSize="20sp"
                android:paddingVertical="5dp"
                android:textStyle="bold"
                android:visibility="gone"/>
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/ll_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@+id/date_label"
            android:paddingVertical="10dp">
            <TextView
                android:id="@+id/tv_from_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/more_background"
                android:padding="10dp"
                android:text="1/2/2025"
                android:textColor="@color/green"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_to_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="2025/1/11"
                android:textColor="@color/green"
                android:layout_weight="1"
                android:textSize="20sp"
                android:background="@drawable/more_background"
                android:padding="10dp"
                android:visibility="invisible"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_report_label1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="5dp"
            android:layout_below="@id/ll_date"
            android:paddingStart="3dp"
            android:background="@color/light_gray">
            <TextView
                android:id="@+id/tv_customer_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textSize="20sp"
                android:layout_weight="1"
                android:textStyle="bold"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Visited Date"
                android:textSize="20sp"
                android:layout_weight="1"
                android:gravity="end"
                android:paddingEnd="3dp"
                android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_report_label2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="5dp"
            android:layout_below="@id/ll_report_label1"
            android:background="@color/light_gray">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="In Time"
                android:textSize="20sp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:paddingStart="3dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Out Time"
                android:textSize="20sp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Total Time"
                android:textSize="20sp"
                android:layout_weight="1"
                android:gravity="end"
                android:textStyle="bold"
                android:paddingEnd="3dp"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_no_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Data Available"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_below="@+id/ll_report_label2"
            android:textSize="18sp"
            android:layout_marginTop="10dp"
            android:visibility="gone"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_report_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:layout_below="@+id/tv_no_data"
            android:layout_above="@+id/ll_total_distance"
            tools:listitem="@layout/item_customer_visit_report"/>


        <LinearLayout
            android:id="@+id/ll_total_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:weightSum="2"
            android:paddingVertical="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Travelled Distance"
                android:textColor="@color/black"
                android:textStyle="normal"
                android:textSize="18sp"/>
            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="18sp"
                android:gravity="end"/>

        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>