<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/layout_toolbar"
        android:id="@+id/layoutToolbar"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">
            <TextView
                android:id="@+id/tv_task_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_name"
                android:layout_marginStart="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cv_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp">

                <EditText
                    android:id="@+id/et_task"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Task Name"
                    android:paddingStart="20dp"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:paddingEnd="20dp"
                    android:paddingVertical="15dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:background="@android:color/transparent"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">
            <TextView
                android:id="@+id/tv_salesperson_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/salesperson_name"
                android:layout_marginStart="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cv_salesperson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp">

                <TextView
                    android:id="@+id/tv_salesperson"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Salesperson Name"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingVertical="15dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:maxLength="70"
                    android:background="@android:color/transparent"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_route_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Route Name"
                android:layout_marginStart="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cv_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp">

                <TextView
                    android:id="@+id/tv_route"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Route Name"
                    android:paddingStart="20dp"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:paddingEnd="20dp"
                    android:paddingVertical="15dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:maxLength="70"
                    android:background="@android:color/transparent"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">
            <TextView
                android:id="@+id/tv_customer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_customer_name"
                android:layout_marginStart="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />


            <androidx.cardview.widget.CardView
                android:id="@+id/cv_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp">

                <TextView
                    android:id="@+id/tv_customer_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Customer Name"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingVertical="15dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:maxLength="70"
                    android:background="@android:color/transparent"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/tv_add_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Customer"
                android:textColor="@color/dark_blue"
                android:layout_marginHorizontal="18dp"
                android:gravity="end"
                android:textStyle="bold"
                android:textSize="15sp"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:weightSum="2">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/task_start_date"
            android:textStyle="bold"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/task_end_date"
                android:textStyle="bold"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:weightSum="2">
            <TextView
                android:id="@+id/tv_start_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2025-05-07"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="@drawable/more_background"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:id="@+id/tv_end_dte"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2025-05-07"
                android:textStyle="bold"
                android:padding="10dp"
                android:background="@drawable/more_background"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/tv_followup_date_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Followup Date"
                android:layout_marginStart="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:weightSum="2">
                <TextView
                    android:id="@+id/tv_followup_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="select date"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:background="@drawable/more_background"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2025-05-07"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:background="@drawable/more_background"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">
            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Details"
                android:layout_marginStart="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginTop="10dp"/>


            <androidx.cardview.widget.CardView
                android:id="@+id/cv_task_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp">

                <EditText
                    android:id="@+id/et_task_detail"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="Enter Task Details"
                    android:paddingStart="20dp"
                    android:inputType="text"
                    android:paddingEnd="20dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:paddingBottom="15dp"
                    android:importantForAutofill="no"
                    android:text=""
                    android:background="@android:color/transparent"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <Button
            android:id="@+id/btn_create_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="10dp"
            android:text="Create Task"/>

    </LinearLayout>
    </ScrollView>




</LinearLayout>