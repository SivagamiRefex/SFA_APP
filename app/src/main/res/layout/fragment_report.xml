<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/layout_toolbar"
        android:visibility="gone"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@+id/ll_toolbar">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="10dp"
            android:layout_margin="10dp"
            android:background="@drawable/more_background"
            android:backgroundTint="@color/light_blue">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_cust_visit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customer Visit Details"
                    android:padding="10dp"
                    android:textSize="18sp"
                    android:textColor="@color/green"
                    android:drawableEnd="@drawable/ic_arrow_right"/>
                <View
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/light_purple"/>

                <TextView
                    android:id="@+id/tv_cust_visit_map"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customer Visit with Map View"
                    android:padding="10dp"
                    android:textSize="18sp"
                    android:textColor="@color/green"
                    android:drawableEnd="@drawable/ic_arrow_right"/>
                <View
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/light_purple"/>

                <TextView
                    android:id="@+id/tv_custom_form_data_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customform Data View Report"
                    android:padding="10dp"
                    android:textSize="18sp"
                    android:textColor="@color/green"
                    android:drawableEnd="@drawable/ic_arrow_right"
                    android:visibility="gone"/>
                <View
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/light_purple"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:padding="10dp"
                    android:textSize="18sp"
                    android:textColor="@color/black"/>
                <View
                    android:layout_marginTop="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/light_purple"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</RelativeLayout>