<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include layout="@layout/layout_toolbar"
        android:id="@+id/layoutToolbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layoutToolbar"
        android:layout_margin="10dp">

        <LinearLayout
            android:id="@+id/ll_sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/tv_sp_label_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sales Person Name"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"

                />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_salesperson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginVertical="10dp">

                <TextView
                    android:id="@+id/tv_select_sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select the Sales Person"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingVertical="15dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:maxLength="70"
                    android:background="@android:color/transparent"/>


            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_month_year_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Month/Year"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_below="@id/ll_sp"
            app:drawableLeftCompat="@drawable/icon_filter"
            tools:ignore="SpUsage"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/C10dp"/>
        <TextView
            android:id="@+id/tv_no_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Data Available"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_below="@+id/tv_month_year_filter"
            android:textSize="18sp"
            android:layout_marginTop="10dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_report_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:layout_below="@+id/tv_no_data"
            tools:listitem="@layout/item_repeat_cust_visit_report"/>



    </RelativeLayout>
</RelativeLayout>