<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/layout_toolbar"
        android:id="@+id/layoutToolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">
                <TextView
                    android:id="@+id/tv_route_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/route_name"
                    android:layout_marginStart="18dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15sp"

                    />


                <androidx.cardview.widget.CardView
                android:id="@+id/cv_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp">

                <EditText
                    android:id="@+id/et_route"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Route Name"
                    android:paddingStart="20dp"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:paddingEnd="20dp"
                    android:paddingVertical="15dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:maxLength="70"
                    android:background="@android:color/transparent"/>


            </androidx.cardview.widget.CardView>
        </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">
                <TextView
                    android:id="@+id/tv_territory_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Territory"
                    android:layout_marginStart="18dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15sp"

                    />


                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_territory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="10dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginVertical="10dp">

                    <EditText
                        android:id="@+id/et_territory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter Territory Name"
                        android:paddingStart="20dp"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:paddingEnd="20dp"
                        android:paddingVertical="15dp"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:importantForAutofill="no"
                        android:background="@android:color/transparent"/>


                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">
                <TextView
                    android:id="@+id/tv_area_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Area "
                    android:layout_marginStart="18dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15sp" />


                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="10dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginVertical="10dp">

                    <EditText
                        android:id="@+id/et_route_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter the Area"
                        android:paddingStart="20dp"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:paddingEnd="20dp"
                        android:paddingVertical="15dp"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:importantForAutofill="no"
                        android:maxLength="70"
                        android:background="@android:color/transparent"/>


                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="@string/save"
                android:textAllCaps="true"
                android:backgroundTint="@color/dark_blue"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>