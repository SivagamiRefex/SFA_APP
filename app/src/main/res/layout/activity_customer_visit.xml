<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/layout_toolbar"
        android:id="@+id/layoutToolbar"/>
    <LinearLayout
        android:id="@+id/ll_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/layoutToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tv_customer_label_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/customer_name"
                android:layout_marginStart="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"

                />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp">

                <TextView
                    android:id="@+id/tv_select_customer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Customer Name"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingVertical="15dp"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:maxLength="70"
                    android:background="@android:color/transparent"/>


            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_edit_cus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Customer"
                android:gravity="end"
                android:layout_marginEnd="@dimen/C20dp"
                android:textColor="@color/dark_blue"
                android:textStyle="bold"
                android:textSize="16sp"
                android:visibility="gone"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_checkin_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="15dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check-In Time: "
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/dark_blue"/>

            <TextView
                android:id="@+id/tv_checkin_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-01-08 00:12:34"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/ref_green"/>



        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10dp"
            >

            <LinearLayout
                android:id="@+id/ll_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_map"
                    android:padding="5dp"
                    android:background="@drawable/shape_circle"
                    android:layout_gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/map_view"
                    android:textColor="@color/dark_blue"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_checkin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_login"
                    android:layout_gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/shape_circle"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_in"
                    android:textColor="@color/dark_blue"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_gravity="center"/>
            </LinearLayout>

           <!-- <LinearLayout
                android:id="@+id/ll_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:visibility="gone">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_assignment"
                    android:layout_gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/shape_circle"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Form Entry"
                    android:textColor="@color/green"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_gravity="center"/>
            </LinearLayout>-->

            <LinearLayout
                android:id="@+id/ll_checkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_logout"
                    android:layout_gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/shape_circle"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_out"
                    android:textColor="@color/dark_blue"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </LinearLayout>



    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="15dp"
        app:cardElevation="10dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="10dp"
        android:layout_below="@+id/ll_head"
        android:backgroundTint="@color/white"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:padding="10dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_product_catalog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp"
                android:backgroundTint="@color/light_blue"
                android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginVertical="@dimen/C20dp"

                >

                <ImageView
                    android:layout_width="@dimen/C60dp"
                    android:layout_height="@dimen/C60dp"
                    android:src="@drawable/ic_co_present"
                    android:layout_gravity="center"
                    app:tint="@color/dark_blue"
                   />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.7dp"
                    android:background="@color/dark_blue"
                    android:visibility="gone"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product catalog"
                    android:textColor="@color/dark_blue"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/C10dp"


                    />



            </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_form_entry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp"
                android:backgroundTint="@color/light_blue"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginVertical="@dimen/C20dp"

                    >

                    <ImageView
                        android:layout_width="@dimen/C60dp"
                        android:layout_height="@dimen/C60dp"
                        android:src="@drawable/ic_edit_document"
                        android:layout_gravity="center"
                        app:tint="@color/dark_blue"
                        />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.7dp"
                        android:background="@color/dark_blue"
                        android:visibility="gone"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Form Entry"
                        android:textColor="@color/dark_blue"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/C10dp"
                        />



                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>